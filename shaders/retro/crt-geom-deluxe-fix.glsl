    float C = dot(poc, poc) - 1.;
    float a = (-B + sqrt(B * B - 4. * A * C)) / (2. * A);
    vec2 uv = (pt - a * sinangle) / cosangle;
    float r = max(abs(params.R.x * acos(a)), 0.00001);
    return uv * r / sin(r / params.R.x);
}

vec2 fragment_transform(vec2 coord, vec3 stretch, vec2 sinangle, vec2 cosangle) {
    coord = (coord - vec2(0.5)) * fragment_aspect.xy * stretch.z + stretch.xy;
    return fragment_bkwtrans(coord, sinangle, cosangle) / fragment_overscan.xy / fragment_aspect.xy + vec2(0.5);
}

float fragment_corner(vec2 coord) {
    coord = (coord - vec2(0.5)) * fragment_overscan.xy + vec2(0.5);
    coord = min(coord, vec2(1.) - coord) * fragment_aspect.xy;
    vec2 cdist = vec2(params.cornersize.x);
    coord = cdist - min(coord, cdist);
    float dist = sqrt(dot(coord, coord));
    return clamp((max(cdist.x, 0.001) - dist) * params.cornersmooth.x, 0., 1.);
}

vec4 fragment_scanlineWeights(float distance, vec4 color) {
    vec4 wid = 0.3 + 0.1 * pow(color, vec4(3.));
    vec4 weights = vec4(distance / wid);
    return 0.4 * exp(-weights * weights) / wid;
}

void fragment_main() {
    vec2 xy;
    if (params.curvature.x > 0.5) xy = fragment_transform(v_texCoord, v_stretch, v_sinangle, v_cosangle); else xy = (v_texCoord - vec2(0.5)) / fragment_overscan.xy + vec2(0.5);
    vec2 xy0 = xy;
    float cval = fragment_corner(xy);
    vec2 ratio_scale = xy * global.SourceSize.xy - vec2(0.5);
    float oversample_filter = fwidth(ratio_scale.y);
    vec2 uv_ratio = fract(ratio_scale);
    xy = (floor(ratio_scale) + vec2(0.5)) / global.SourceSize.xy;
    vec4 coeffs = 3.1415927 * vec4(1. + uv_ratio.x, uv_ratio.x, 1. - uv_ratio.x, 2. - uv_ratio.x);
    coeffs = max(abs(coeffs), 0.00001);
    coeffs = 2. * sin(coeffs) * sin(coeffs / 2.) / (coeffs * coeffs);
    coeffs /= dot(coeffs, vec4(1.));
    vec4 col = clamp(texture(internal1, xy + vec2(-v_one.x, 0.)) * coeffs.x + texture(internal1, xy) * coeffs.y + texture(internal1, xy + vec2(v_one.x, 0.)) * coeffs.z + texture(internal1, xy + vec2(2. * v_one.x, 0.)) * coeffs.w, 0., 1.);
    vec4 col2 = clamp(texture(internal1, xy + vec2(-v_one.x, v_one.y)) * coeffs.x + texture(internal1, xy + vec2(0., v_one.y)) * coeffs.y + texture(internal1, xy + v_one) * coeffs.z + texture(internal1, xy + vec2(2. * v_one.x, v_one.y)) * coeffs.w, 0., 1.);
    col = pow(col, vec4(params.CRTgamma.x));
    col2 = pow(col2, vec4(params.CRTgamma.x));
    vec4 weights = fragment_scanlineWeights(uv_ratio.y, col);
    vec4 weights2 = fragment_scanlineWeights(1. - uv_ratio.y, col2);
    uv_ratio.y = uv_ratio.y + 1. / 3. * oversample_filter;
    weights = (weights + fragment_scanlineWeights(uv_ratio.y, col)) / 3.;
    weights2 = (weights2 + fragment_scanlineWeights(abs(1. - uv_ratio.y), col2)) / 3.;
    uv_ratio.y = uv_ratio.y - 2. / 3. * oversample_filter;
    weights = weights + fragment_scanlineWeights(abs(uv_ratio.y), col) / 3.;
    weights2 = weights2 + fragment_scanlineWeights(abs(1. - uv_ratio.y), col2) / 3.;
    vec3 mul_res = (col * weights + col2 * weights2).rgb;
    vec3 blur = pow(texture(blur, xy0).rgb, vec3(params.CRTgamma.x));
    mul_res = mix(mul_res, blur, params.halation.x) * vec3(cval);
    mul_res = pow(mul_res, vec3(1. / params.monitorgamma.x));
    xy = v_texCoord.xy * vec2(HOOKED_size);
    vec3 mask = vec3(1.);
    if (fragment_mask_picker == 0) {
        FragColor = vec4(mul_res, col.a);
        return;
    } else if (fragment_mask_picker == 1) mask = texture(aperture, xy * 0.3333).rgb; else if (fragment_mask_picker == 2) mask = texture(slot, xy * 0.25).rgb; else mask = texture(delta, xy * 0.49999).rgb;
    mask = mix(vec3(1.), mask, params.aperture_strength.x);
    FragColor = vec4(mul_res * mask, col.a);
}

vec4 hook() {
    vertex_main();
    fragment_main();
    return delinearize(FragColor);
}

