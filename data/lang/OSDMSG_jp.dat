# OSDMSG_jp.dat - By TyRaS-SW
# Japanese OSD messages for MPV-SW-Capture scripts
# Keep %s placeholders intact. A literal \n inside a value is a line break.

# ============================================================
#  Bezel fit messages
# ============================================================
nsoretro_no_bezel=先にベゼルを選択してください!
nsoretro_fill_on=16:9 をベゼルに合わせる: ON
nsoretro_fill_off=16:9 をベゼルに合わせる: OFF
nsoretro_reset=ベゼル調整: リセット

# ============================================================
#  Crop fit messages
# ============================================================
nsoretro_no_crop=先にCropを選択してください！
nsoretro_crop_fill_on=フル16:9をCropに合わせる: ON
nsoretro_crop_fill_off=フル16:9をCropに合わせる: OFF

# ============================================================
#  NSO RETRO WARNINGS (bezel)
# ============================================================
nsoretro_stretch_blocked=ベゼル有効中はウィンドウの伸縮が無効です
nsoretro_gpu_unavailable=NSO Retro: GPUベゼルは利用できません (%s)。CPUベゼルを使用します。
nsoretro_hole_failed=NSO Retro: ベゼルの穴の作成に失敗しました (%s)
nsoretro_ps1_missing=NSO Retro: bezel_to_bgra.ps1 が見つかりません (mpv の data フォルダに置いてください)。CPUベゼルを使用します。

# ============================================================
#  MIRROR
# ============================================================
mirrortoggle_on=ミラー ON
mirrortoggle_off=ミラー OFF

# ============================================================
#  AUTOCOMPRESS (Recording)
# ============================================================
autocompress_processing=処理および結合中...
autocompress_wait_processing=⏳ お待ちください! 前の録画をまだ処理中です...
autocompress_mkdir_fail=_record フォルダを作成できませんでした
autocompress_merge_error=❌ 録画の結合中にエラーが発生しました
autocompress_recording_label=🔴 録画中
autocompress_finishing_label=⏳ 録画を終了しています。お待ちください!
autocompress_done_label=✅ 完了しました!
autocompress_quit_blocked=録画中です。先に録画を停止してください。
autocompress_emergency_save=緊急保存を実行しました。マージは終了後に完了します。
autocompress_recovered=中断された録画を復元しました。
autocompress_recover_failed=録画を復元できませんでした。ファイルは削除されました。

