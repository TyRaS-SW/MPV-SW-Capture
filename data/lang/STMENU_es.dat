UnlockMenu=Desbloquear Menú
HideOSD=Ocultar Mensajes OSD
ShowOSD=Mostrar Mensajes OSD

# --- Action buttons ---
Screenshot=Captura
Record=Grabar
InfoStream=Información del Stream
CleanALL=Limpiar TODO
ShowMenu=Mostrar Menú

# --- Open / Close ---
